# Copy this file to .env only in a private deployment. Never commit real values.
# VS Code debug configurations load .env; ordinary terminals must export the
# same variables into the current process before running the CLI.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_RISK_TABLE_ID=
FEISHU_TASK_TABLE_ID=
FEISHU_CASE_TABLE_ID=
# Production only accepts the official HTTPS endpoint. A custom endpoint is
# available solely to injected automated-test transports with test_mode=True.
# FEISHU_API_BASE=https://open.feishu.cn/open-apis

# Optional injected model-reasoner credential. The repository does not bundle
# a provider SDK/client, and the public demo remains deterministic when empty.
TORQUE_GUARD_MODEL_API_KEY=

# Optional server-side Terra drafting for the local administrator service.
# Never put a real key in this example, browser code, screenshots, or commits.
# Leave the URL and model empty to use the guarded defaults.
CODEKEY_API_KEY=
CODEKEY_BASE_URL=
CODEKEY_TERRA_MODEL=
