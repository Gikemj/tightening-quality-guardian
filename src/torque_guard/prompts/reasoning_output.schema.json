{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torque-guard.local/schemas/reasoning-output-1.0.json",
  "title": "TorqueGuard controlled reasoning output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision",
    "conclusion",
    "hypotheses",
    "uncertainty",
    "refusal_reason",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision": {"enum": ["supported", "refused"]},
    "conclusion": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "evidence_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "confidence", "evidence_ids", "verification"],
        "properties": {
          "cause": {"type": "string", "minLength": 1},
          "confidence": {"enum": ["low", "medium", "medium-high", "high"]},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "verification": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertainty": {"type": "string", "minLength": 1},
    "refusal_reason": {"type": ["string", "null"]},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_human_approval", "automatic_action_allowed"],
      "properties": {
        "requires_human_approval": {"const": true},
        "automatic_action_allowed": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "supported"}}},
      "then": {
        "properties": {
          "conclusion": {"type": "object"},
          "hypotheses": {"minItems": 1},
          "refusal_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "refused"}}},
      "then": {
        "properties": {
          "conclusion": {"type": "null"},
          "hypotheses": {"maxItems": 0},
          "refusal_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
